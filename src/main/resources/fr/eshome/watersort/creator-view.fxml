<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<AnchorPane fx:id="root" maxHeight="600.0" maxWidth="1400.0" minHeight="500.0" minWidth="500.0" prefHeight="600.0"
            prefWidth="800.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="fr.eshome.watersort.creator.CreatorController">
    <children>
        <GridPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
                  AnchorPane.topAnchor="0.0">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" percentWidth="100.0"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" percentHeight="90.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" percentHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints/>
            </rowConstraints>
            <children>
                <HBox alignment="CENTER_RIGHT" prefHeight="101.0" prefWidth="800.0" spacing="10.0"
                      GridPane.rowIndex="1">
                    <children>
                        <Button fx:id="useThisGameButton" mnemonicParsing="false" onAction="#onCreateGame"
                                prefWidth="180.0"
                                text="Use this game"/>
                        <Button fx:id="backButton" mnemonicParsing="false" onAction="#onBack" prefWidth="180.0"
                                text="Back"/>
                    </children>
                    <padding>
                        <Insets left="30.0" right="30.0"/>
                    </padding>
                </HBox>
                <VBox alignment="TOP_CENTER" spacing="10.0">
                    <children>
                        <HBox alignment="CENTER" prefWidth="200.0" spacing="10.0">
                            <VBox.margin>
                                <Insets top="15.0"/>
                            </VBox.margin>
                            <children>
                                <ToggleButton graphicTextGap="1.0" mnemonicParsing="false" onAction="#chooseColor"
                                              prefHeight="30.0" prefWidth="37.0" selected="true">
                                    <graphic>
                                        <Pane fx:id="pane1"/>
                                    </graphic>
                                    <toggleGroup>
                                        <ToggleGroup fx:id="etienne"/>
                                    </toggleGroup>

                                </ToggleButton>
                                <ToggleButton graphicTextGap="1.0" mnemonicParsing="false" onAction="#chooseColor"
                                              prefHeight="30.0" prefWidth="37.0" toggleGroup="$etienne">
                                    <graphic>
                                        <Pane fx:id="pane2"/>
                                    </graphic>
                                </ToggleButton>
                                <ToggleButton graphicTextGap="1.0" mnemonicParsing="false" onAction="#chooseColor"
                                              prefHeight="30.0" prefWidth="37.0" toggleGroup="$etienne">
                                    <graphic>
                                        <Pane fx:id="pane3"/>
                                    </graphic>
                                </ToggleButton>
                                <ToggleButton graphicTextGap="1.0" mnemonicParsing="false" onAction="#chooseColor"
                                              prefHeight="30.0" prefWidth="37.0" toggleGroup="$etienne">
                                    <graphic>
                                        <Pane fx:id="pane4"/>
                                    </graphic>
                                </ToggleButton>
                                <ToggleButton graphicTextGap="1.0" mnemonicParsing="false" onAction="#chooseColor"
                                              prefHeight="30.0" prefWidth="37.0" toggleGroup="$etienne">
                                    <graphic>
                                        <Pane fx:id="pane5"/>
                                    </graphic>
                                </ToggleButton>
                                <ToggleButton graphicTextGap="1.0" mnemonicParsing="false" onAction="#chooseColor"
                                              prefHeight="30.0" prefWidth="37.0" toggleGroup="$etienne">
                                    <graphic>
                                        <Pane fx:id="pane6"/>
                                    </graphic>
                                </ToggleButton>
                            </children>
                        </HBox>
                        <HBox alignment="CENTER" prefWidth="200.0" spacing="10.0">
                            <VBox.margin>
                                <Insets/>
                            </VBox.margin>
                            <children>
                                <Label fx:id="nbCol1" alignment="CENTER" contentDisplay="TOP" minWidth="37.0" text="0"/>
                                <Label fx:id="nbCol2" alignment="CENTER" contentDisplay="TOP" minWidth="37.0" text="0"/>
                                <Label fx:id="nbCol3" alignment="CENTER" contentDisplay="TOP" minWidth="37.0" text="0"/>
                                <Label fx:id="nbCol4" alignment="CENTER" contentDisplay="TOP" minWidth="37.0" text="0"/>
                                <Label fx:id="nbCol5" alignment="CENTER" contentDisplay="TOP" minWidth="37.0" text="0"/>
                                <Label fx:id="nbCol6" alignment="CENTER" contentDisplay="TOP" minWidth="37.0" text="0"/>
                            </children>
                        </HBox>
                        <HBox fx:id="tubesLocation" alignment="BOTTOM_CENTER" prefHeight="300.0" prefWidth="600.0"/>
                    </children>
                    <padding>
                        <Insets bottom="40.0"/>
                    </padding>
                </VBox>
            </children>
        </GridPane>
    </children>
</AnchorPane>

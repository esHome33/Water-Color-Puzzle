<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<AnchorPane fx:id="root" maxHeight="600.0" maxWidth="1400.0" minHeight="500.0" minWidth="500.0" prefHeight="600.0"
            prefWidth="800.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="fr.eshome.watersort.creator.CreatorController">
    <children>
        <GridPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
                  AnchorPane.topAnchor="0.0">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" percentWidth="100.0"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" percentHeight="80.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" percentHeight="20.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints/>
            </rowConstraints>
            <children>
                <HBox alignment="TOP_CENTER" spacing="10.0" GridPane.rowIndex="1">
                    <children>
                        <Button mnemonicParsing="false" onAction="#onCreateGame" prefWidth="180.0"
                                text="Use this game"/>
                        <Button fx:id="backButton" mnemonicParsing="false" onAction="#onBack" prefWidth="180.0"
                                text="Back"/>
                    </children>
                    <padding>
                        <Insets bottom="40.0" left="5.0" right="5.0" top="40.0"/>
                    </padding>
                </HBox>
                <VBox alignment="TOP_CENTER" spacing="10.0">
                    <children>
                        <HBox alignment="CENTER" prefHeight="70.0" prefWidth="200.0" spacing="3.0">
                            <VBox.margin>
                                <Insets top="30.0"/>
                            </VBox.margin>
                            <children>
                                <ToggleButton fx:id="btn1" mnemonicParsing="false" onAction="#chooseColor"
                                              prefHeight="30.0" prefWidth="37.0" selected="true">
                                    <toggleGroup>
                                        <ToggleGroup fx:id="etienne"/>
                                    </toggleGroup>
                                    <graphic>
                                        <Pane fx:id="pane1"/>
                                    </graphic>
                                </ToggleButton>
                                <ToggleButton fx:id="btn2" mnemonicParsing="false" onAction="#chooseColor"
                                              prefHeight="30.0" prefWidth="37.0" toggleGroup="$etienne">
                                    <graphic>
                                        <Pane fx:id="pane2"/>
                                    </graphic>
                                </ToggleButton>
                                <ToggleButton fx:id="btn3" mnemonicParsing="false" onAction="#chooseColor"
                                              prefHeight="30.0" prefWidth="37.0" toggleGroup="$etienne">
                                    <graphic>
                                        <Pane fx:id="pane3"/>
                                    </graphic>
                                </ToggleButton>
                                <ToggleButton fx:id="btn4" mnemonicParsing="false" onAction="#chooseColor"
                                              prefHeight="30.0" prefWidth="37.0" toggleGroup="$etienne">
                                    <graphic>
                                        <Pane fx:id="pane4"/>
                                    </graphic>
                                </ToggleButton>
                                <ToggleButton fx:id="btn5" mnemonicParsing="false" onAction="#chooseColor"
                                              prefHeight="30.0" prefWidth="37.0" toggleGroup="$etienne">
                                    <graphic>
                                        <Pane fx:id="pane5"/>
                                    </graphic>
                                </ToggleButton>
                                <ToggleButton fx:id="btn6" mnemonicParsing="false" onAction="#chooseColor"
                                              prefHeight="30.0" prefWidth="37.0" toggleGroup="$etienne">
                                    <graphic>
                                        <Pane fx:id="pane6"/>
                                    </graphic>
                                </ToggleButton>
                            </children>
                        </HBox>
                        <HBox fx:id="tubesLocation" alignment="BOTTOM_CENTER" prefHeight="300.0" prefWidth="600.0"/>
                    </children>
                    <padding>
                        <Insets bottom="40.0"/>
                    </padding>
                </VBox>
            </children>
        </GridPane>
    </children>
</AnchorPane>
